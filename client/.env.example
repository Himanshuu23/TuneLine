# Copy to client/.env.local for `npm run dev`.
# Next.js only loads env files from this folder, not the repo root.
# On Vercel, set the same names in Project Settings → Environment Variables.

NEXT_PUBLIC_WS_URL=ws://localhost:11011/ws
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
